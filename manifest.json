{
  "manifest_version": 3,
  "name": "HumanType",
  "version": "1.1",
  "description": "Types text letter-by-letter, mimicking human writing patterns.",
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HumanType",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
